{
  "name": "kosui",
  "version": "0.5.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kosolabs/kosui.git"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "pnpm run \"/^(build|check|lint|test:unit)$/\""
  },
  "engines": {
    "node": ">= 20"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "dependencies": {
    "@lucide/svelte": "^1.1.0",
    "clsx": "^2.1.1",
    "marked": "^18.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/load-config": "0.2.3",
    "@sveltejs/package": "3.0.3",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.10",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "highlight.js": "11.12.0",
    "highlight.svelte": "0.1.3",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "publint": "0.3.25",
    "svelte": "^5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2",
    "web-features": "^3.45.0"
  },
  "keywords": [
    "svelte"
  ],
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#ui": "./src/ui/index.js",
    "#ui/*": "./src/ui/*"
  }
}
